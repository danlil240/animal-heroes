.worktrees/
.superpowers/
.tools/
build/
*.tmp
game/.godot/
*.gd.uid
__pycache__/
graphify-out/

# Secrets — never commit credentials, keystores, or key material.
# The release keystore lives outside the repo (~/keystores/); its password
# lives only in GNOME Keyring. These patterns are a backstop.
*.jks
*.keystore
*.kdbx
*.p12
*.pfx
*.pem
*.key
*.crt
.env
.env.*
*credentials*
*credential*
secrets.json
secret.json
password.txt
release/paired_devices.json

# Visual test output — baselines are tracked, run artifacts are not.
test-output/*
!test-output/baselines/

# Godot in-engine test harness staging dir (run_visual_tests.py relocates
# screenshots to repo-root test-output/; nothing here should be tracked).
game/test-output/

# Smoke evidence — curated *.md summaries are tracked release evidence;
# raw device snapshots (*.txt, run-duration-seconds.txt, apk-sha256.txt)
# are per-run artifacts parsed into the .md files.
docs/test-results/*
!docs/test-results/*.md